# Copy to server/.env and replace every placeholder. Never commit the real file.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
MONGO_URL=mongodb://127.0.0.1:27017/whiteboard
# Random secrets of at least 32 characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<random-secret-at-least-32-chars>
LOGIN_HMAC_KEY=<another-random-secret-at-least-32-chars>
# Base URL used in share links (the client origin).
PUBLIC_URL=http://localhost:5173
# Only needed when the client is served from a different origin than the API.
CLIENT_ORIGIN=
# Serve the built client from this server (production): path to client/dist
CLIENT_DIST=
# Periodic version interval T in ms (D11a: 5 minutes)
VERSION_INTERVAL_MS=300000
BCRYPT_COST=12
LOG_LEVEL=debug
LOG_FILE=logs/server.log
# Deployment behind a TLS-terminating proxy (SEC-REQ-007). FORCE_HTTPS=true requires TRUST_PROXY=true
# and an https:// PUBLIC_URL; the server refuses to start otherwise.
TRUST_PROXY=false
FORCE_HTTPS=false
