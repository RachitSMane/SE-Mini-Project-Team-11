{
  "name": "se-mini-project-team-11",
  "private": true,
  "description": "Real-Time Collaborative Virtual Whiteboard (Team 11)",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "db:start": "node scripts/start-mongo.js",
    "dev": "node scripts/dev.js",
    "start": "npm run start -w server",
    "build": "npm run build -w client",
    "build:test": "npm run build:test -w client",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:e2e": "npm run build:test && playwright test",
    "test:e2e:browsers": "npm run build:test && node scripts/e2e-browsers.js",
    "perf": "node scripts/perf/run-all.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
